          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-da70q7nqgx_#27",
          "text": "5. Das Zitronen-Frosting auf dem noch lauwarmen Kuchen verstreichen und nach Belieben mit Zitronenscheiben dekorieren.",
          "vorschlagIstZutat": false,
          "klasse": "step+to-taste",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-daw4krusc4l#4",
          "text": "📌Speicher dir das Rezept unbedingt ab – das wirst du garantiert öfter machen!",
          "vorschlagIstZutat": false,
          "klasse": "promo",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-daw4krusc4l#16",
          "text": "• 1 Handvoll Lauchzwiebeln, in feine Ringe geschnitten",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-dbd7eldrupt#4",
          "text": "Wenn du das nicht verpassen willst, dann folge mir ✅💪🏼",
          "vorschlagIstZutat": false,
          "klasse": "promo",
          "korrekturIstZutat": null,
