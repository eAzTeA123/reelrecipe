          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-dbd7eldrupt#20",
          "text": "🌮Salz, Pfeffer, Paprikapulver, Tomatengewürz & ein paar Chiliflocken",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-dbxltnpiq5i#30",
          "text": "Folge mir für High Protein Rezepte, die perfekt für die Diät geeignet sind & Speichere dir das Rezept für später damit du es nicht wieder suchen musst 😬",
          "vorschlagIstZutat": false,
          "klasse": "promo",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "lib-dcvzerymzzn#21",
          "text": "Mit Salz abschmecken und zum Servieren noch etwas Kokosmilch darübergeben. Mit frischem Koriander und Chiliöl toppen. Wer mag, gibt zum Schluss noch etwas frischen Limettensaft darüber – passt richtig gut zur cremigen Kokosmilch und der leichten Schärfe vom Gochujang. 🌶️🥥",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit+to-taste",
