          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "marvin-ddyyzx5ipqj#51",
          "text": "❤️ Folge mir für mehr einfache High Protein Rezepte für deine Diät und schicke es an jemanden, der das unbedingt ausprobieren muss!",
          "vorschlagIstZutat": false,
          "klasse": "promo",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dc879w_t4f6#2",
          "text": "Wenn du Cheeseburger liebst, aber mal etwas anderes als den klassischen Burger möchtest: Dieser Cheeseburger-Auflauf ist genau das Richtige. 🤤🍔",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dc879w_t4f6#6",
          "text": "Das Beste: maximal 𝙪𝙣𝙠𝙤𝙢𝙥𝙡𝙞𝙯𝙞𝙚𝙧𝙩, richtig schön 𝙘𝙝𝙚𝙚𝙨𝙮 und 𝙥𝙚𝙧𝙛𝙚𝙠𝙩 für ein gemütliches Abendessen. Und ja – auch beim Abnehmen darf so etwas auf dem Teller landen. 😏",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dc879w_t4f6#12",
          "text": "1 𝙱𝚞𝚛𝚐𝚎𝚛:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dc879w_t4f6#16",
          "text": "𝚉𝚞𝚝𝚊𝚝𝚎𝚗:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dc879w_t4f6#38",
          "text": "𝚉𝚞𝚋𝚎𝚛𝚎𝚒𝚝𝚞𝚗𝚐:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#8",
          "text": "🛒 𝙕𝙪𝙩𝙖𝙩𝙚𝙣 𝙛ü𝙧 2 𝙋𝙤𝙧𝙩𝙞𝙤𝙣𝙚𝙣:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#10",
          "text": "𝘍ü𝘳 𝘥𝘢𝘴 𝘎𝘺𝘳𝘰𝘴:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#24",
          "text": "𝘍ü𝘳 𝘥𝘪𝘦 𝘗𝘪𝘵𝘢-𝘊𝘩𝘪𝘱𝘴:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#30",
          "text": "🫓etwas Oregano",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#32",
          "text": "🫓etwas Knoblauch",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#34",
          "text": "🫓etwas Salz",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#36",
          "text": "𝘍ü𝘳 𝘥𝘢𝘴 𝘛𝘻𝘢𝘵𝘻𝘪𝘬𝘪:",
          "vorschlagIstZutat": false,
          "klasse": "heading",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#66",
          "text": "1. Hähnchen in sehr dünne Streifen schneiden, mit Öl und Gewürzen vermengen. In einer heißen beschichteten Pfanne kräftig anbraten, bis es schön gebräunt und leicht knusprig ist.",
          "vorschlagIstZutat": false,
          "klasse": "step",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#68",
          "text": "2. Pita klein schneiden, mit Öl, Oregano, Knoblauch & Salz vermengen und bei 180–190 °C ca. 4–6 Min. im Airfryer goldbraun rösten. Alternativ in der Pfanne rösten.",
          "vorschlagIstZutat": false,
          "klasse": "step+range",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#70",
          "text": "3. Gurke raspeln, mit Salz bestreuen und kurz stehen lassen und dann sehr gut ausdrücken. Mit Joghurt, Knoblauch, Zitronensaft & Dill verrühren und mit Salz und Pfeffer abschmecken.",
          "vorschlagIstZutat": false,
          "klasse": "step",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-dcnjnqynwwk#72",
          "text": "4. Salat, Tomate, Gurke & Zwiebel in eine Bowl geben. Gyros darauf verteilen, Pita-Chips darübergeben und großzügig mit Tzatziki toppen. Mit Feta, Petersilie & Oregano garnieren. 🥙✨",
          "vorschlagIstZutat": false,
          "klasse": "step",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-ddb7e3ets9c#52",
          "text": "1. 𝙃𝙖𝙨𝙚𝙡𝙣𝙪𝙨𝙨-𝘾𝙧𝙚𝙢𝙚 🤍",
          "vorschlagIstZutat": false,
          "klasse": "step",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-ddb7e3ets9c#54",
          "text": "Skyr, Magerquark & Haselnusscreme miteinander verrühren. Milch & das Mark der Vanilleschote dazugeben und mit Süßstoff abschmecken. Eine kleine Prise Salz dazugeben – das verstärkt den Haselnuss- und Schokoladengeschmack.",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-ddb7e3ets9c#56",
          "text": "2. 𝙎𝙘𝙝𝙤𝙠𝙤-𝘾𝙧𝙚𝙢𝙚 🍫",
          "vorschlagIstZutat": false,
          "klasse": "step",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-ddb7e3ets9c#58",
          "text": "Kakao und Schoko-Proteinpulver mit der Milch verrühren. Nach Geschmack süßen. Die Creme sollte eher dickflüssig sein.",
          "vorschlagIstZutat": false,
          "klasse": "to-taste",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-ddb7e3ets9c#80",
          "text": "Jeweils 1 Bueno-Riegel grob in Stücke brechen und auf die Creme setzen. Mit Haselnüssen bestreuen und etwas Schoko-Creme verzieren.",
          "vorschlagIstZutat": false,
          "klasse": "unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "medusas-ddb7e3ets9c#86",
          "text": "Ich habe für das Protein Pulver \"Double Chocolate\" von @officialbodylab24 genommen. 𝙆𝙡𝙚𝙞𝙣𝙚𝙧 𝙏𝙞𝙥𝙥: Wenn ihr noch mehr Bueno Geschmack haben möchtet dann nutzt für die Creme noch ein paar Tropfen \"Bueno Queen\" von @gymqueen.de",
          "vorschlagIstZutat": false,
          "klasse": "nutrition+unquantified-unit",
          "korrekturIstZutat": null,
          "korrekturName": null,
          "korrekturMenge": null,
          "korrekturEinheit": null
        },
        {
          "lineId": "noel-dd0-4wriewb#6",
          "text": "Rabattcode: ❗️👉🏼NOEL👈🏼❗️",
